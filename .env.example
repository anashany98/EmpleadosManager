# ==========================================
# EmpleadosManager - LOCAL DEVELOPMENT ONLY
# ==========================================
# This file is for LOCAL development only.
# For production, use: backend/.env.production.template
# And generate secrets with: ./scripts/generate-secrets.sh
# ==========================================

# Database (local dev only - NEVER use in production)
POSTGRES_USER=nominas
POSTGRES_PASSWORD=nominas_local_pw_2026
POSTGRES_DB=nominas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nominas:nominas_local_pw_2026@localhost:5432/nominas_db?schema=public

# Authentication (local dev only - NEVER use in production)
# Production: Run ./scripts/generate-secrets.sh
JWT_SECRET=local_jwt_secret_change_me_2026
ENCRYPTION_KEY=local_encryption_key_32_chars!!!
KIOSK_DEVICE_SECRET=local_kiosk_secret_change_me_2026

# CORS & Cookies (local dev)
CORS_ORIGIN=http://localhost:17171,http://127.0.0.1:17171,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:17171
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token
CSRF_MAX_AGE_MS=604800000

# Storage
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis
REDIS_URL=redis://default:password@hostname:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backup
BACKUP_UPLOAD=false

# Frontend
VITE_API_URL=
PUBLIC_API_URL=
