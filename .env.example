# RRHH environment template
# Copy values into your local `.env` or deployment secret manager.
# Never commit real secrets.

# Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database
POSTGRES_USER=rrhh
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=rrhh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rrhh:<postgres-password>@postgres:5432/rrhh?schema=public

# Authentication and encryption
JWT_SECRET=<64-plus-character-random-secret>
ENCRYPTION_KEY=<32-byte-random-key>
KIOSK_DEVICE_SECRET=<64-plus-character-random-secret>
RETURN_TOKENS=false

# CORS and cookies
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=strict
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token
CSRF_MAX_AGE_MS=604800000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_URL=redis://default:<redis-password>@redis:6379/0

# Storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=<s3-endpoint>
S3_REGION=us-east-1
S3_BUCKET=<s3-bucket>
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>

# Backups
BACKUP_UPLOAD=true
BACKUP_ENCRYPTION_KEY=<32-byte-random-key>
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# S3 Backup Configuration
BACKUP_S3_ENABLED=false
AWS_ACCESS_KEY_ID=<s3-access-key-id>
AWS_SECRET_ACCESS_KEY=<s3-secret-access-key>
AWS_REGION=us-east-1
S3_ENDPOINT=<s3-endpoint>
BACKUP_S3_BUCKET=<s3-backup-bucket>

# Frontend
VITE_API_URL=
PUBLIC_API_URL=https://app.example.com
