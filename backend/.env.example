# ==========================================
# EmpleadosManager - Backend Configuration
# ==========================================
# Copy this file to .env and configure for your environment
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=production  # Change to 'production' in production

# Domain Configuration
DOMAIN_NAME="rrhh.tuempresa.com"  # Your production domain
VITE_API_URL="https://rrhh.tuempresa.com/api"  # Frontend API URL

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nominas_db"

# JWT & Security - ?? CRITICAL: Change these in production!
# JWT Secret must be at least 32 characters, cryptographically random
JWT_SECRET="change-me-to-a-32-char-minimum-secret-in-production"

# Encryption key for sensitive data (AES-256) - MUST be exactly 32 characters
ENCRYPTION_KEY="<GENERATE-RANDOM-32-CHARACTER-KEY>"

# Kiosk device authentication
KIOSK_DEVICE_SECRET="change-this-kiosk-secret"

# Bcrypt rounds for password hashing (10-12 recommended)
BCRYPT_ROUNDS=10

# CORS / Cookies Configuration
CORS_ORIGIN="http://localhost:5173,https://rrhh.tuempresa.com"  # Comma-separated: dev + production
COOKIE_SECURE="true"  # HTTPS only in production
COOKIE_DOMAIN=".tuempresa.com"  # Leading dot for subdomains
COOKIE_SAMESITE="lax"  # strict | lax | none
CSRF_COOKIE_NAME="csrf_token"
CSRF_HEADER_NAME="x-csrf-token"
CSRF_MAX_AGE_MS="604800000"  # 7 days in milliseconds
FRONTEND_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"  # 1 minute
RATE_LIMIT_MAX_REQUESTS="100"

# Storage Provider - Choose: 's3', 'local', 'azure'
STORAGE_PROVIDER="s3"

# S3 Storage Configuration (required if STORAGE_PROVIDER=s3)
S3_ENDPOINT=""  # e.g., https://s3.amazonaws.com or custom endpoint
S3_REGION="us-east-1"
S3_BUCKET=""  # Your bucket name
S3_ACCESS_KEY_ID=""  # AWS access key
S3_SECRET_ACCESS_KEY=""  # AWS secret key
# Note: S3_FORCE_PATH_STYLE is auto-detected when S3_ENDPOINT is set (path-style for MinIO/custom).
# Note: S3_PUBLIC_URL is not read; bucket public access must be configured on the S3 side.

# Local Storage (if STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH="./uploads"

# Backup Configuration
# =====================
# Automated backups are performed by the prodrigestivill/postgres-backup-local
# container (see docker-compose.yml service "backup"). It is INDEPENDENT of
# the backend process — if the backend crashes, backups keep running.
#
# The internal BackupScheduler (Node.js) is DISABLED to avoid duplicating work.
# The on-demand HTTP endpoint POST /api/config/backup still works for manual
# snapshots and uses the legacy BACKUP_ENCRYPTION_KEY below.

# Cron schedule for the dedicated backup container (default: 02:00 daily).
# Format: standard 5-field cron expression.
BACKUP_SCHEDULE="0 2 * * *"

# Local retention inside the backup container (volumen backup_data).
# Keeps daily/weekly/monthly copies: BACKUP_KEEP_DAYS most recent days,
# then one per week for the last BACKUP_KEEP_WEEKS weeks, then one per
# month for the last BACKUP_KEEP_MONTHS months.
BACKUP_RETENTION_DAYS="30"
BACKUP_KEEP_WEEKS="4"
BACKUP_KEEP_MONTHS="6"

# Off-site backup to OneDrive (Microsoft 365) via rclone sidecar.
# This is the RECOMMENDED off-site destination for small/medium deployments
# that already have a Microsoft 365 subscription (1 TB included in most plans).
#
# Setup: run scripts/setup-onedrive.sh ONCE on the host. It opens an
# interactive rclone config that walks you through the Microsoft OAuth flow
# in your browser. The resulting token is stored in the 'rclone_config'
# Docker volume and persists across container recreates.
#
# The sidecar 'rclone-onedrive' in docker-compose.yml runs rclone sync
# every 24h, mirroring /var/lib/docker/volumes/rrhh_backup_data to OneDrive.
# On-demand sync: docker compose exec rclone-onedrive rclone sync /data onedrive:$ONEDRIVE_PATH
#
# To disable: comment out the 'rclone-onedrive' service in docker-compose.yml.
ONEDRIVE_REMOTE="onedrive"            # nombre del remote en rclone.conf (no cambiar)
ONEDRIVE_PATH="rrhh-backups"          # carpeta destino en OneDrive

# Off-site backup to S3 (ALTERNATIVE to OneDrive — pick one, not both).
# Use DEDICATED IAM credentials with s3:PutObject + s3:ListBucket + s3:GetObject
# scoped ONLY to BACKUP_S3_BUCKET. Rotate independently from the main app's
# S3 credentials. Enable SSE-S3 or SSE-KMS on the bucket for encryption at rest.
# Compatible with: AWS S3, Backblaze B2, Wasabi, MinIO, Cloudflare R2.
BACKUP_S3_ENABLED="false"
BACKUP_S3_BUCKET="rrhh-backups-prod"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
# Optional: S3-compatible endpoint (Backblaze, Wasabi, MinIO, R2). Empty for AWS.
S3_ENDPOINT=""

# Legacy: only used by the on-demand HTTP endpoint (POST /api/config/backup)
# and the internal BackupService. Not used by the prodrigestivill container
# (that container does NOT encrypt — encrypt at S3 level with SSE instead).
# PBKDF2-SHA512 passphrase. Must be at least 32 characters.
# Loss of this key = loss of all manually-triggered encrypted backups.
BACKUP_UPLOAD="false"
BACKUP_ENCRYPTION_KEY="<GENERATE-RANDOM-AT-LEAST-32-CHARACTERS>"

# Redis Configuration (for caching and queues)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
# Or use single URL: REDIS_URL="redis://:password@localhost:6379"
REDIS_NAMESPACE="nominas:"

# Monitoring & Observability - ?? Highly Recommended for Production
SENTRY_DSN="https://your-key@your-region.ingest.sentry.io/your-project-id"  # Get from https://sentry.io
SENTRY_TRACES_SAMPLE_RATE="0.1"  # 0.0 to 1.0 (reduce in production)
SENTRY_PROFILES_SAMPLE_RATE="0.1"  # 0.0 to 1.0
SENTRY_RELEASE="1.0.0"  # Or use $GIT_COMMIT in CI/CD
SENTRY_ENVIRONMENT="production"  # Set appropriately

# Application Insights (optional - Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Logging Configuration
LOG_LEVEL="info"  # error | warn | info | http | verbose | debug | silly
LOG_FORMAT="json"  # 'json' for production, 'pretty' for development

# Performance Tuning
PRISMA_QUERY_TIMEOUT="10000"  # milliseconds
PRISMA_CONNECT_TIMEOUT="10000"  # milliseconds
WORKER_CONCURRENCY="5"  # Number of parallel queue workers

# Email Configuration (optional - for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@yourcompany.com"
EMAIL_REPLY_TO="hr@yourcompany.com"

# Alert Configuration
ALERT_EMAIL="hr@yourcompany.com"  # Where to send system alerts
ALERT_WEBHOOK_URL=""  # Optional: webhook for alerts (e.g., Slack, Teams)

# Security Headers
HSTS_MAX_AGE="31536000"  # 1 year in seconds (production only)
CSP_REPORT_URI=""  # CSP violation reports endpoint

# Feature Flags
ENABLE_REGISTRATION="true"  # Allow new user registration
ENABLE_OCR="true"  # Enable OCR for document processing
ENABLE_AUDIT_TRAIL="true"  # Log all data changes

# Development Options (disable in production)
RETURN_TOKENS="false"  # ?? SECURITY: Set to false in production!
ENABLE_SWAGGER="false"  # Set to true for API documentation in dev
SWAGGER_PASSWORD=""  # Basic auth for swagger (if enabled)

