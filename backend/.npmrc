# IMP-004: política de dependencias para backend.
# Aplica al instalar, pero NO afecta a CI (que ya tiene npm
# configurado). Cada línea documenta el por qué.

# engine-strict=true: si el `engines` del package.json dice
# node>=22, npm aborta en vez de avisar. Evita "funciona en
# mi máquina con Node 24 pero rompe en Coolify con Node 20".
engine-strict=true

# save-exact=false (defecto): usamos semver caret (^) que es
# el estándar de npm. Pin exacto solo para deps con
# breaking changes frecuentes (lo declaramos en DEPENDENCY_POLICY).
# Cambiar a `true` global petaría el flujo actual.

# package-lock=true: asegura que SIEMPRE se usa el lockfile
# (impide instalaciones "loose" que generen package-lock.json
# distintos entre máquinas). El lockfile DEBE commitearse.
package-lock=true

# audit-level=high: cualquier advisory high+ rompe el install.
# En package.json ya hay `audit:check` con --omit=dev para
# producción. Aquí rompemos también dev deps, lo que
# garantiza que nadie añada un paquete vulnerable ni como
# devDependency.
audit-level=high

# fund=false: el mensaje "1 package is looking for funding" al
# final de cada install es ruido. Lo apagamos.
fund=false

# update-notifier=false: igual, ruido.
update-notifier=false

# prefer-offline=true: si el paquete ya está en cache, no
# pregunta al registro. Acelerra CI sin perder determinismo
# porque el lockfile es la fuente de verdad.
prefer-offline=true
