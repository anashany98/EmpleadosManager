# ==========================================
# EmpleadosManager - Production Environment
# ==========================================
# HOW TO USE:
#   1. Run: ./scripts/generate-secrets.sh
#   2. Copy the generated values below
#   3. Set these in Coolify Environment Variables
#   4. NEVER commit this file with real values to git
# ==========================================

# Server Configuration
NODE_ENV=production
PORT=3000

# Domain Configuration - UPDATE WITH YOUR REAL DOMAIN
DOMAIN_NAME="rrhh.tuempresa.com"
VITE_API_URL="https://rrhh.tuempresa.com/api"
PUBLIC_API_URL="https://rrhh.tuempresa.com/api"

# Database - USE GENERATED PASSWORD (never use default!)
POSTGRES_USER="nominas"
POSTGRES_PASSWORD="<RUN: ./scripts/generate-secrets.sh>"
POSTGRES_DB="nominas_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://nominas:<GENERATED_PASSWORD>@postgres:5432/nominas_db?schema=public&connection_timeout=10"

# JWT & Security - MUST be generated, NEVER use defaults in production
# Run: ./scripts/generate-secrets.sh
JWT_SECRET="<RUN: ./scripts/generate-secrets.sh>"
ENCRYPTION_KEY="<RUN: ./scripts/generate-secrets.sh>"  # Must be exactly 32 characters
KIOSK_DEVICE_SECRET="<RUN: ./scripts/generate-secrets.sh>"
BCRYPT_ROUNDS=12

# CORS / Cookies - UPDATE WITH YOUR DOMAIN
CORS_ORIGIN="https://rrhh.tuempresa.com"
FRONTEND_URL="https://rrhh.tuempresa.com"
COOKIE_SECURE=true
COOKIE_DOMAIN=.tuempresa.com
COOKIE_SAMESITE=strict
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token
CSRF_MAX_AGE_MS=604800000

# Storage
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Backup
BACKUP_UPLOAD=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<RUN: ./scripts/generate-secrets.sh>
REDIS_NAMESPACE=nominas:

# Monitoring - GET FROM SENTRY.IO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=production

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json

# Performance
PRISMA_QUERY_TIMEOUT=10000
PRISMA_CONNECT_TIMEOUT=10000

# Email (configure with your SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nominas App <noreply@tuempresa.com>"
EMAIL_REPLY_TO=hr@tuempresa.com

# Alerts
ALERT_EMAIL=admin@tuempresa.com
ALERT_WEBHOOK_URL=

# Feature Flags
ENABLE_REGISTRATION=false
ENABLE_OCR=true
ENABLE_AUDIT_TRAIL=true
RETURN_TOKENS=false
ENABLE_SWAGGER=false
