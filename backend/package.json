{
    "name": "nominas-backend",
    "version": "1.0.0",
    "description": "Backend API for NominasApp",
    "main": "src/index.ts",
    "scripts": {
        "start": "node --require ./instrument.js dist/backend/src/index.js",
        "dev": "nodemon src/index.ts",
        "build": "tsc",
        "lint": "eslint .",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest --watch",
        "prisma:generate": "node ../scripts/prisma-local.mjs generate",
        "prisma:migrate": "node ../scripts/prisma-local.mjs migrate dev",
        "prisma:status": "node ../scripts/prisma-local.mjs migrate status",
        "seed:admin": "ts-node src/scripts/seed-admin.ts",
        "seed:profiles": "ts-node src/scripts/seed-profiles.ts",
        "seed:data": "ts-node src/scripts/populate_data.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.620.1",
        "@aws-sdk/s3-request-presigner": "^3.620.1",
        "@prisma/client": "^5.x",
        "@sentry/node": "^8.55.1",
        "@sentry/profiling-node": "^9.47.1",
        "@types/nodemailer": "^7.0.5",
        "@types/pdfkit": "^0.17.4",
        "@types/qrcode": "^1.5.6",
        "archiver": "^7.0.1",
        "axios": "^1.15.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.67.3",
        "canvas": "^3.2.0",
        "chokidar": "^5.0.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.3.1",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^8.2.2",
        "helmet": "^8.1.0",
        "imapflow": "^1.2.4",
        "ioredis": "^5.9.2",
        "jpeg-js": "^0.4.4",
        "jsonwebtoken": "^9.0.3",
        "jsqr": "^1.4.0",
        "mailparser": "^3.9.1",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.5",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^5.4.530",
        "pdfkit": "^0.17.2",
        "pino": "^10.3.0",
        "pino-pretty": "^13.1.3",
        "pngjs": "^7.0.0",
        "qrcode": "^1.5.4",
        "socket.io": "^4.8.3",
        "tesseract.js": "^7.0.0",
        "uuid": "^11.0.5",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/archiver": "^7.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/chokidar": "^1.7.5",
        "@types/cookie-parser": "^1.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/express-rate-limit": "^5.1.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mailparser": "^3.4.6",
        "@types/multer": "^1.4.13",
        "@types/node": "^20.10.4",
        "@types/node-cron": "^3.0.11",
        "@types/pino": "^7.0.4",
        "@types/pino-pretty": "^4.7.5",
        "@types/pngjs": "^6.0.5",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^4.1.4",
        "eslint": "^10.2.1",
        "globals": "^17.5.0",
        "nodemon": "^3.0.2",
        "prisma": "^5.x",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.59.1",
        "vitest": "^4.0.18"
    }
}
