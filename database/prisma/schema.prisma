  content      String?   @db.Text
  ocrStatus    String    @default("PENDING") // PENDING, COMPLETED, FAILED
  processed    Boolean   @default(false)
  processedAt  DateTime?
  companyId    String?
  /// SHA-256 del contenido del archivo. Permite deduplicar por
  /// contenido (no por filename) y se usa para prevenir que
  /// workers concurrentes creen dos `InboxDocument` con el mismo
  /// archivo. La unicidad se delega al índice único del schema
  /// (ver MED-004).
  contentHash  String?   @db.Text

  @@unique([contentHash])
  @@index([processed])
  @@index([source])
  @@index([receivedAt])
