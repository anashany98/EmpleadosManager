  @@index([timestamp])
}

enum LockAction {
  ACQUIRED
  RELEASED
  EXPIRED
  FORCE_RELEASED
  REFRESHED
}

// GDPR consent record. Captures explicit, granular consent given by
// the data subject (employee) for specific processing activities
// that are not strictly necessary for the employment contract.
//
// Examples of `purpose`:
//   - "MEDICAL_DATA_PROCESSING"      (Article 9(2)(a) — explicit consent for health data)
//   - "MARKETING_COMMUNICATIONS"
//   - "THIRD_PARTY_DATA_SHARING"
//   - "BIOMETRIC_DATA"               (face recognition, fingerprint)
//
// Withdrawal of consent must be at least as easy as giving it
// (GDPR Art. 7(3)). The DELETE endpoint is exposed; a soft-delete
// (anonymising the user_id) is also acceptable but we keep the
// record for the legally-required retention period.
model Consent {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purpose       String // see comment above
  granted       Boolean // true = consent given, false = consent withdrawn
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  ipAddress     String?
  userAgent     String?
  legalBasis    String    @default("CONSENT") // CONSENT | CONTRACT | LEGAL_OBLIGATION | VITAL_INTEREST | PUBLIC_TASK | LEGITIMATE_INTEREST
  // Free-text policy version the user consented to. GDPR Art. 7(1)
  // requires demonstrable evidence of what the user agreed to.
  policyVersion String    @default("1.0.0")
  notes         String?

  @@index([employeeId])
  @@index([purpose])
  @@index([granted])
  @@index([grantedAt])
}

// Control de Gestoría y Control Horario RRHH
model PayrollControlPeriod {
  id             String                 @id @default(uuid())
  companyId      String
  year           Int
  month          Int
  status         String                 @default("DRAFT") // DRAFT, IN_REVIEW, CLOSED, EXPORTED, SENT_TO_AGENCY, REOPENED
