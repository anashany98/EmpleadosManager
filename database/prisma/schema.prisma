  closedById     String?
  reopenedAt     DateTime?
  reopenedById   String?
  formulaVersion String                 @default("2026-control-v1")
  exportedAt     DateTime?
  exportedById   String?
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  records        PayrollControlRecord[]
  exports        PayrollControlExport[]

  @@unique([companyId, year, month])
  @@index([companyId])
  @@index([year, month])
  @@index([status])
}

model PayrollControlRecord {
