generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  dni                   String?                @unique // Login alternative
  employeeId            String? // Link to specific employee record
  password              String
  role                  String                 @default("user")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  permissions           String?
  isActive              Boolean                @default(true)
  sessionVersion        Int                    @default(0)
  failedLoginAttempts   Int                    @default(0)
  lockedUntil           DateTime?
  auditLogs             AuditLog[]
  exports               Export[]
  payrollControlExports PayrollControlExport[]
  batches               PayrollImportBatch[]
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  obraExpensesCreated   ObraExpense[]
  obraImportsCreated    ObraImportBatch[]
  employee              Employee?              @relation(fields: [employeeId], references: [id])
  createdEvents         CalendarEvent[]        @relation("EventCreator")
  assignedHrTasks       HrTask[]                @relation("HrTaskAssignee")
  createdHrTasks        HrTask[]                @relation("HrTaskCreator")
  completedHrTasks      HrTask[]                @relation("HrTaskCompleter")
  closedMonthlyCloses   HrMonthlyClose[]        @relation("HrMonthlyCloseCloser")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  employeeId String
  purpose    String    @default("PASSWORD_RESET")
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict) // GDPR: restrict to force soft-delete

  @@index([employeeId, purpose, usedAt])
  @@index([expiresAt])
}

model Company {
  id                           String                        @id @default(uuid())
  name                         String
  cif                          String                        @unique
  logoUrl                      String?
  legalRep                     String? // Apoderado
  address                      String?
  postalCode                   String?
  city                         String?
  province                     String?
  country                      String?
  email                        String?
  phone                        String?
  officeLatitude               Float?
  officeLongitude              Float?
  allowedRadius                Int?                          @default(100) // Meters
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  employees                    Employee[]
  onboardingTemplates          OnboardingTemplate[]
  documentTemplates            DocumentTemplate[]
  vehicles                     Vehicle[]
  cards                        Card[]
  fileMappings                 FileMapping[]
  calendarEvents               CalendarEvent[]
  payrollControlPeriods        PayrollControlPeriod[]
  payrollControlConceptConfigs PayrollControlConceptConfig[]
  employmentPeriods            EmploymentPeriod[]
  employeeScheduleEntries      EmployeeScheduleEntry[]
  holidays                     Holiday[]
  hrTasks                      HrTask[]
  alertRules                   HrAlertRule[]
  alertDeliveries              HrAlertDelivery[]
  monthlyCloses                HrMonthlyClose[]
}

model PermissionProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id                        String    @id @default(uuid())
  dni                       String    @unique
  name                      String
  firstName                 String?
  lastName                  String?
  email                     String?
  phone                     String?
  address                   String?
  city                      String?
  postalCode                String?
  province                  String?
  registeredIn              String?
  birthDate                 DateTime?
  gender                    String?
  subaccount465             String?   @unique
  // Código estable que usa la gestoría. No se infiere nunca de DNI, nombre
  // ni UUID durante una exportación.
  payrollAgencyEmployeeCode String?
  active                    Boolean   @default(true)
  // Soft-delete: GDPR right-to-be-forgotten. When set, the row is
  // hidden from all reads and excluded from FK joins. The data is
  // physically purged by a scheduled job after the configured
  // retention period (default 4 years for payroll, 5 for medical).
  deletedAt                 DateTime?
  deletedById               String?
  deletionReason            String?
  socialSecurityNumber      String?
  iban                      String?
  dniExpiration             DateTime?
  drivingLicense            Boolean   @default(false)
  drivingLicenseType        String?
  drivingLicenseExpiration  DateTime?

  // Encrypted-at-rest PII fields (GDPR Art. 32). SOURCE OF TRUTH for sensitive
  // identifiers. The plaintext columns above stay at their last-known value (or
  // empty for new rows) for ad-hoc SQL queries, but the application layer MUST
  // use these `*Enc` fields and decrypt via EncryptionService. Stored as
  // `gcm:iv:authTag:ciphertext` (AES-256-GCM).
  dniEnc                   String?                   @db.Text
  socialSecurityNumberEnc  String?                   @db.Text
  ibanEnc                  String?                   @db.Text
  companyPhone             String?
  companyId                String?
  company                  Company?                  @relation(fields: [companyId], references: [id])
  onboadings               EmployeeOnboarding[]
  department               String?
  category                 String?
  contractType             String?
  agreementType            String?
  jobTitle                 String?
  contractEndDate          DateTime?
  managerId                String?
  entryDate                DateTime?
  exitDate                 DateTime?
  callDate                 DateTime?
  contractInterruptionDate DateTime?
  lowDate                  DateTime?
  lowReason                String?
  vacationDaysTotal        Int                       @default(30)
  workingDayType           String?
  weeklyHours              Float?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  country                  String?                   @default("España")
  annualGrossSalary        Decimal?                  @default(0) @db.Decimal(15, 2)
  monthlyGrossSalary       Decimal?                  @default(0) @db.Decimal(15, 2)
  annualTotalSalary        Decimal?                  @default(0) @db.Decimal(15, 2)
  monthlyTotalSalary       Decimal?                  @default(0) @db.Decimal(15, 2)
  // Encrypted-at-rest salary fields. These are the SOURCE OF TRUTH.
  // The `Decimal` columns above stay at 0 (or with the same value for
  // backward-compat reads inside the same query); the application
  // layer MUST use the `Enc` fields and decrypt via EncryptionService.
  // Stored as `gcm:iv:authTag:ciphertext` (AES-256-GCM).
  annualGrossSalaryEnc     String?                   @db.Text
  monthlyGrossSalaryEnc    String?                   @db.Text
  annualTotalSalaryEnc     String?                   @db.Text
  monthlyTotalSalaryEnc    String?                   @db.Text
  companyShortPhone        String?
  privateNotes             String?
  accountingEntries        AccountingEntry[]
  alerts                   Alert[]
  assets                   Asset[]
  targetAuditLogs          AuditLog[]                @relation("TargetEmployee")
  checklistTasks           ChecklistTask[]
  contractExtensions       ContractExtension[]
  documents                Document[]
  manager                  Employee?                 @relation("Hierarchy", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: NoAction) // FIX: SetNull so subordinates stay with managerId=null when manager is deleted
  subordinates             Employee[]                @relation("Hierarchy")
  projectWork              EmployeeProjectWork[]
  expenses                 Expense[]
  obraExpenses             ObraExpense[]
  managedObras             Project[]                 @relation("ObraManager")
  medicalReviews           MedicalReview[]
  overtimeEntries          OvertimeEntry[]
  payrollRows              PayrollRow[]
  timeEntries              TimeEntry[]
  trainings                Training[]
  vacations                Vacation[]
  vacationBalances         EmployeeVacationBalance[]
  emergencyContacts        EmergencyContact[]
  consents                 Consent[]
  anomalies                AnomalyEvent[]

  vehicles               Vehicle[]
  cards                  Card[]
  users                  User[]
  passwordResetTokens    PasswordResetToken[]
  evaluations            Evaluation[]           @relation("EvaluationEmployee")
  evaluationsAsEvaluator Evaluation[]           @relation("EvaluationEvaluator")
  peerReviews            PeerReview[]
  objectives             Objective[]
  pdis                   PDI[]
  payrollControlRecords  PayrollControlRecord[]
  employmentPeriods      EmploymentPeriod[]
  scheduleEntries        EmployeeScheduleEntry[]
  gestoriaRows           GestoriaEmployeeRow[]
  hrTasks                HrTask[]

  @@unique([companyId, payrollAgencyEmployeeCode])
  @@index([companyId])
  @@index([active])
  @@index([deletedAt])
  @@index([department])
  @@index([contractType])
  @@index([contractEndDate])
  @@index([entryDate])
  @@index([dniExpiration])
  @@index([managerId])
  @@index([email])
  @@index([companyId, active])
  @@index([companyId, department])
  @@index([active, contractEndDate])
}

model EmployeeVacationBalance {
  id               String   @id @default(uuid())
  employeeId       String
  year             Int
  annualQuotaDays  Decimal  @default(30)
  carriedOverDays  Decimal  @default(0)
  importedUsedDays Decimal  @default(0)
  advancedDays     Decimal  @default(0) // Días tomados por adelantado del año siguiente
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict) // GDPR: restrict to force soft-delete

  @@unique([employeeId, year])
  @@index([year])
}

model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  name         String
  phone        String
  relationship String? // Padre, Madre, Pareja...
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict) // GDPR: restrict to force soft-delete

  @@index([employeeId])
}

model Project {
  id           String                @id @default(uuid())
  code         String                @unique
  name         String
  destination  String?
  description  String?
  clientName   String?
  startDate    DateTime?
  endDate      DateTime?
  budget       Decimal?              @db.Decimal(15, 2)
  managerId    String?
  status       String                @default("ACTIVE")
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  employeeWork EmployeeProjectWork[]
  expenses     ObraExpense[]
  imports      ObraImportBatch[]
  manager      Employee?             @relation("ObraManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([managerId])
}

model EmployeeProjectWork {
  id         String   @id @default(uuid())
  employeeId String
  projectId  String
  startDate  DateTime
  endDate    DateTime
  hours      Float    @default(8.0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction) // FIX: Cascade so project work records are deleted when project is deleted
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction) // GDPR: restrict to force soft-delete

  @@index([employeeId])
  @@index([projectId])
  @@index([startDate, endDate])
}

model ObraExpense {
  id            String           @id @default(uuid())
  obraId        String
  employeeId    String?
  type          String
  date          DateTime
  endDate       DateTime?
  amount        Decimal          @db.Decimal(15, 2)
  originalAmount Decimal?        @db.Decimal(15, 2)
  unitAmount     Decimal?        @db.Decimal(15, 2)
  unitCount      Int             @default(1)
  allocationGroupId String?
  allocationIndex Int?
  allocationCount Int            @default(1)
  sourceReference String?
  currency      String           @default("EUR")
  description   String?
  vendor        String?
  reference     String?
  origin        String?
  destination   String?
  receiptUrl    String?
  status        String           @default("APPROVED")
  importBatchId String?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  obra          Project          @relation(fields: [obraId], references: [id], onDelete: Cascade)
  employee      Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  importBatch   ObraImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: NoAction)

  // MED-010: unicidad (obraId, reference) para que dos imports
  // concurrentes del mismo archivo NO creen gastos duplicados
  // (gasto inflado / fraude contable). En PostgreSQL, los
  // NULLs son distintos en UNIQUE, así que múltiples filas
  // con `reference IS NULL` siguen siendo válidas. El
  // controller usa `createMany({ skipDuplicates: true })`
  // para convertir el P2002 en warning idempotente.
  @@unique([obraId, reference])
  @@index([obraId, type])
  @@index([obraId, date])
  @@index([employeeId])
  @@index([allocationGroupId])
  @@index([status])
  @@index([importBatchId])
}

model ObraImportBatch {
  id             String        @id @default(uuid())
  obraId         String?
  sourceFilename String
  sourceFileUrl  String?
  status         String        @default("UPLOADED")
  resultSummary  String?
  mappingRules   String?
  warnings       String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  obra           Project?      @relation(fields: [obraId], references: [id], onDelete: SetNull)
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: NoAction)
  expenses       ObraExpense[]

  @@index([status])
  @@index([obraId])
}

model Asset {
  id              String         @id @default(uuid())
  employeeId      String?
  category        String
  name            String
  serialNumber    String?
  size            String?
  assignedDate    DateTime?
  returnDate      DateTime?
  status          String         @default("ASSIGNED")
  notes           String?
  inventoryItemId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  employee        Employee?      @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model ChecklistTask {
  id          String    @id @default(uuid())
  employeeId  String
  type        String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction) // GDPR: restrict to force soft-delete; hard delete must purge explicitly

  @@index([employeeId, type])
}

model Expense {
  id            String   @id @default(uuid())
  employeeId    String
  date          DateTime @default(now())
  category      String
  amount        Decimal  @db.Decimal(15, 2)
  description   String?
  receiptUrl    String?
  status        String   @default("PENDING")
  paymentMethod String   @default("CASH")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction) // GDPR: restrict to force soft-delete; hard delete must purge explicitly

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@index([category])
  @@index([employeeId, status])
}

model Document {
  id         String    @id @default(uuid())
  employeeId String
  name       String
  category   String
  fileUrl    String
  content    String?   @db.Text
  uploadDate DateTime  @default(now())
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction) // GDPR: restrict to force soft-delete; hard delete must purge explicitly

  @@index([employeeId])
  @@index([category])
  @@index([expiryDate])
  @@index([uploadDate])
  @@index([employeeId, category])
}

model MedicalReview {
  id             String    @id @default(uuid())
  employeeId     String
  date           DateTime
  result         String?
  nextReviewDate DateTime?
  /// Empleado renuncia / declina pasar la prueba médica (semánticamente distinto del resultado médico).
  /// Cuando es true, el resultado del médico puede no existir.
  declined       Boolean   @default(false)
  /// Motivo o notas cuando el empleado declina (ej. "renuncia expresa", "causa religiosa", etc.)
  declineReason  String?
  fileUrl        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction) // GDPR: restrict to force soft-delete; hard delete must purge explicitly

  @@index([employeeId])
  @@index([date])
  @@index([declined])
}

model Training {
  id         String   @id @default(uuid())
  employeeId String
  type       String
  name       String
  date       DateTime
  hours      Int?
  fileUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict) // GDPR: restrict to force soft-delete
}

model Vacation {
  id              String      @id @default(uuid())
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  type            String      @default("VACATION")
  absenceType     AbsenceType @default(VACATION)
  days            Int         @default(0)
  reason          String?
  fileUrl         String?
  status          String      @default("PENDING")
  rejectionReason String?
  managerComment  String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict) // GDPR: restrict to force soft-delete

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@index([status])
}

model VacationArchive {
  id              String      @id @default(uuid())
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  type            String      @default("VACATION")
  absenceType     AbsenceType @default(VACATION)
  days            Int         @default(0)
  reason          String?
  fileUrl         String?
  status          String      @default("PENDING")
  rejectionReason String?
  managerComment  String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime
  updatedAt       DateTime
  archivedAt      DateTime    @default(now())
  archiveReason   String?
}

/// Tipos de reporte soportados por el scheduler.
/// Antes era String libre, lo que permitía typos y valores
/// legacy divergentes. IMP-003: forzar enum para que el cron
/// nunca ejecute un `reportType` desconocido.
enum ScheduleReportType {
  ATTENDANCE
  ATTENDANCE_SUMMARY
  OVERTIME
  VACATION
  COSTS
  ABSENCES
  ABSENCES_DETAILED
  KPIS
  GENDER_GAP
  CUSTOM
}

/// Frecuencia de ejecución de un ReportSchedule.
/// Antes String libre; ahora enum acotado. Cualquier valor fuera
/// del enum se rechaza con 400 antes de tocar la BD.
enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum AbsenceType {
  VACATION
  SICK
  MATERNITY
  PATERNITY
  MEDICAL_APPOINTMENT
  UNPAID
  OTHER
  MARRIAGE
  DEATH
  MOVING
  FAMILY_SICK
  PUBLIC_DUTY
  LACTATION
}

model AbsenceTypeConfig {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  color              String   @default("#6366f1")
  icon               String   @default("calendar")
  description        String?
  annualLimitDays    Int?
  countsForBalance   Boolean  @default(false)
  requiresAttachment Boolean  @default(false)
  requiresApproval   Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String // NDA, RGPD, MODEL_145, UNIFORM, EPI, TECH_DEVICE, PAYROLL, CONTRACT
  name      String // Nombre descriptivo
  content   String // Contenido HTML/Markdown con variables {{variable}}
  variables String // JSON con lista de variables soportadas
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false) // Si es el default para empresas sin template específico
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
  @@index([type])
}

model MappingProfile {
  id        String               @id @default(uuid())
  name      String
  rules     String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  batches   PayrollImportBatch[]
}

model PayrollImportBatch {
  id               String            @id @default(uuid())
  year             Int
  month            Int
  sourceFilename   String
  sourceFileUrl    String?
  status           String            @default("UPLOADED")
  resultSummary    String?
  notes            String?
  mappingProfileId String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  entries          AccountingEntry[]
  exports          Export[]
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mappingProfile   MappingProfile?   @relation(fields: [mappingProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction) // FIX: SetNull so batches persist with mappingProfileId=null when profile is deleted
  rows             PayrollRow[]
}

model PayrollRow {
  id              String             @id @default(uuid())
  batchId         String
  rawEmployeeName String?
  employeeId      String?
  bruto           Decimal            @default(0)
  ssEmpresa       Decimal            @default(0)
  ssTrabajador    Decimal            @default(0)
  irpf            Decimal            @default(0)
  neto            Decimal            @default(0)
  extraData       String?
  status          String             @default("PENDING")
  validationNotes String?
  /// Versión del rule set fiscal usado para calcular esta fila.
  /// Permite reproducir nóminas históricas aunque cambien las
  /// tasas. Ver PayrollRulesService. Cerrado HIGH-009.
  ruleSetVersion  String?
  employee        Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction) // FIX: SetNull so payroll rows persist with employeeId=null when employee is deleted
  batch           PayrollImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction) // FIX: Cascade so payroll rows are deleted when batch is deleted
  items           PayrollItem[]
}

model PayrollItem {
  id           String     @id @default(uuid())
  payrollRowId String
  concept      String
  amount       Decimal
  type         String // "EARNING", "DEDUCTION"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  payrollRow   PayrollRow @relation(fields: [payrollRowId], references: [id], onDelete: Cascade, onUpdate: NoAction) // FIX: Cascade so payroll items are deleted when payroll row is deleted

  @@index([payrollRowId])
}

model AccountingEntry {
  id         String                @id @default(uuid())
  batchId    String
  employeeId String?
  concept    String
  document   String?
  date       DateTime
  totalDebe  Decimal
  totalHaber Decimal
  status     String                @default("DRAFT")
  createdAt  DateTime              @default(now())
  employee   Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction) // FIX: SetNull so accounting entries persist with employeeId=null when employee is deleted
  batch      PayrollImportBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction) // FIX: Cascade so accounting entries are deleted when batch is deleted
  lines      AccountingEntryLine[]
}

model AccountingEntryLine {
  id       String          @id @default(uuid())
  entryId  String
  account  String
  concept  String
  debe     Decimal
  haber    Decimal
  document String?
  order    Int
  entry    AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: NoAction) // FIX: Cascade so entry lines are deleted when accounting entry is deleted
}

model Export {
  id          String             @id @default(uuid())
  batchId     String
  type        String
  filename    String
  generatedAt DateTime           @default(now())
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction) // KEPT: required FK, NoAction prevents orphaning exports
  batch       PayrollImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: NoAction) // FIX: Cascade so exports are deleted when batch is deleted
}

model AuditLog {
  id               String    @id @default(uuid())
  action           String
  entity           String
  entityId         String
  metadata         String?
  userId           String?
  targetEmployeeId String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  targetEmployee   Employee? @relation("TargetEmployee", fields: [targetEmployeeId], references: [id], onDelete: SetNull, onUpdate: NoAction) // FIX: SetNull so audit logs persist with targetEmployeeId=null when employee is deleted
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction) // FIX: SetNull so audit logs persist with userId=null when user is deleted

  @@index([userId])
  @@index([targetEmployeeId])
  @@index([createdAt, entity])
}

model CategoryRate {
  id                  String   @id @default(uuid())
  category            String   @unique
  overtimeRate        Decimal  @default(0) @db.Decimal(6, 4)
