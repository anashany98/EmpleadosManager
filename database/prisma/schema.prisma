  holidayOvertimeHours         Decimal  @default(0) @db.Decimal(10, 2)
  holidayOvertimeHoursManual   Decimal? @db.Decimal(10, 2)
  isHolidayOvertimeHoursManual Boolean  @default(false)

  totalOvertimeAmountCalculated Decimal  @default(0) @db.Decimal(12, 2)
  totalOvertimeAmount           Decimal  @default(0) @db.Decimal(12, 2)
  totalOvertimeAmountManual     Decimal? @db.Decimal(12, 2)
  isTotalOvertimeAmountManual   Boolean  @default(false)

  positiveVariable         Decimal  @default(0) @db.Decimal(12, 2)
  positiveVariableManual   Decimal? @db.Decimal(12, 2)
  isPositiveVariableManual Boolean  @default(false)

  negativeVariable         Decimal  @default(0) @db.Decimal(12, 2)
  negativeVariableManual   Decimal? @db.Decimal(12, 2)
  isNegativeVariableManual Boolean  @default(false)

  diets         Decimal  @default(0) @db.Decimal(12, 2)
  dietsManual   Decimal? @db.Decimal(12, 2)
  isDietsManual Boolean  @default(false)

  irpf         Decimal  @default(0) @db.Decimal(6, 4)
  irpfManual   Decimal? @db.Decimal(6, 4)
  isIrpfManual Boolean  @default(false)

  tgss         Decimal  @default(0) @db.Decimal(6, 4)
  tgssManual   Decimal? @db.Decimal(6, 4)
  isTgssManual Boolean  @default(false)

  availablePercentageCalculated Decimal  @default(0) @db.Decimal(6, 4)
  availablePercentage           Decimal  @default(0) @db.Decimal(6, 4)
  availablePercentageManual     Decimal? @db.Decimal(6, 4)
  isAvailablePercentageManual   Boolean  @default(false)

  grossCalculated Decimal  @default(0) @db.Decimal(12, 2)
  gross           Decimal  @default(0) @db.Decimal(12, 2)
  grossManual     Decimal? @db.Decimal(12, 2)
  isGrossManual   Boolean  @default(false)

  productivityCalculated Decimal  @default(0) @db.Decimal(12, 4)
  productivity           Decimal  @default(0) @db.Decimal(12, 4)
  productivityManual     Decimal? @db.Decimal(12, 4)
  isProductivityManual   Boolean  @default(false)

  hoursCalculated     Decimal  @default(0) @db.Decimal(12, 2)
  hoursAmount         Decimal  @default(0) @db.Decimal(12, 2)
  hoursAmountManual   Decimal? @db.Decimal(12, 2)
  isHoursAmountManual Boolean  @default(false)

  differenceCalculated     Decimal  @default(0) @db.Decimal(12, 2)
  difference               Decimal  @default(0) @db.Decimal(12, 2)
  differenceManual         Decimal? @db.Decimal(12, 2)
  isDifferenceManual       Boolean  @default(false)
  reconciliationCalculated Decimal  @default(0) @db.Decimal(12, 4)

  customConcepts String? @db.Text
  observations   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  period        PayrollControlPeriod         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee      Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  overrides     PayrollControlOverride[]
  conceptValues PayrollControlConceptValue[]
  dailyEntries  PayrollControlDailyEntry[]

  @@unique([periodId, employeeId])
  @@index([periodId])
  @@index([employeeId])
}

model PayrollControlOverride {
  id              String               @id @default(uuid())
  recordId        String
  fieldName       String
  calculatedValue String?
  manualValue     String?
  previousValue   String?
  newValue        String?
  userId          String?
  createdAt       DateTime             @default(now())
  record          PayrollControlRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([fieldName])
}

model PayrollControlConceptConfig {
  id           String   @id @default(uuid())
  companyId    String
  key          String
  label        String
  gestoriaCode String?
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values  PayrollControlConceptValue[]

  @@unique([companyId, key])
  @@index([companyId])
}

/// Tramos contractuales reales de un empleado. Permite conservar todas las
/// bajas y reactivaciones sin sobrescribir el historial en Employee.
model EmploymentPeriod {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  startDate   DateTime
  endDate     DateTime?
  startReason String?
  endReason   String?
  endType     String?
  createdById String?
  endedById   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, startDate])
  @@index([companyId, startDate, endDate])
  @@index([companyId, endDate, endType])
  @@index([endDate])
}

enum GestoriaPeriodStatus {
  OPEN
  CLOSED
}

enum GestoriaConceptType {
  HOURS
  PRICE
  AMOUNT
  PERCENT
  BOOLEAN
  TEXT
}

model GestoriaPeriod {
  id              String                @id @default(uuid())
  companyId       String
  year            Int
  month           Int
  status          GestoriaPeriodStatus  @default(OPEN)
  exportMapping   Json?
  notes           String?
  closedAt        DateTime?
  closedById      String?
  reopenReason    String?
  reopenedAt      DateTime?
  reopenedById    String?
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  concepts        GestoriaConcept[]
  rows            GestoriaEmployeeRow[]
  views           GestoriaColumnView[]
  exportLogs      GestoriaExportLog[]

  @@unique([companyId, year, month])
  @@index([companyId])
  @@index([status])
  @@index([year, month])
}

model GestoriaConcept {
  id           String               @id @default(uuid())
  periodId     String
  code         String
  label        String
  type         GestoriaConceptType
  decimals     Int                  @default(2)
  isSystem     Boolean              @default(false)
  isVisible    Boolean              @default(true)
  order        Int                  @default(0)
  gestoriaCode String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  period       GestoriaPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cells        GestoriaCell[]

  @@unique([periodId, code])
  @@index([periodId, order])
  @@index([periodId, isVisible])
  @@index([periodId, gestoriaCode])
}

model GestoriaEmployeeRow {
  id           String          @id @default(uuid())
  periodId     String
  employeeId   String?
  employeeName String
  department   String?
  category     String?
  observations String?
  isReviewed   Boolean         @default(false)
  reviewedAt   DateTime?
  reviewedById String?
  totalHours   Decimal?        @db.Decimal(10, 2)
  totalAmount  Decimal?        @db.Decimal(15, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  period       GestoriaPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee     Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  cells        GestoriaCell[]

  @@unique([periodId, employeeId])
  @@index([periodId])
  @@index([employeeId])
  @@index([periodId, isReviewed])
}

model GestoriaCell {
  id           String              @id @default(uuid())
  rowId        String
  conceptId    String
  numericValue Decimal?            @db.Decimal(15, 4)
  textValue    String?
  sourceType   String?
  sourceRefId  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  row          GestoriaEmployeeRow @relation(fields: [rowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  concept      GestoriaConcept     @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rowId, conceptId])
  @@index([rowId])
  @@index([conceptId])
}

model GestoriaColumnView {
  id             String          @id @default(uuid())
  userId         String
  periodId       String
  viewName       String
  columnOrder    Json
  hiddenConcepts Json
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  period         GestoriaPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, periodId, viewName])
  @@index([userId])
  @@index([periodId])
}

model GestoriaExportLog {
  id              String          @id @default(uuid())
  periodId        String
  generatedById   String
  outputFilename  String
  fileSize        Int
  fileHash        String
  rowCount        Int
  totalAmount     Decimal?        @db.Decimal(15, 2)
  mappingSnapshot Json
  notes           String?
  downloadCount   Int             @default(0)
  generatedAt     DateTime        @default(now())
  period          GestoriaPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([periodId])
  @@index([generatedById])
  @@index([generatedAt])
}

model EmployeeScheduleEntry {
  id          String    @id @default(uuid())
  employeeId  String
  companyId   String?
  date        DateTime  @db.Date
  entry1      DateTime? @db.Time(6)
  exit1       DateTime? @db.Time(6)
  entry2      DateTime? @db.Time(6)
  exit2       DateTime? @db.Time(6)
  discountMin Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([employeeId, date])
  @@index([employeeId, date(sort: Desc)])
  @@index([companyId, date(sort: Desc)])
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  scope     String   @default("NATIONAL")
  region    String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([date, scope, region, companyId])
  @@index([date])
}

model PayrollControlConceptValue {
  id              String   @id @default(uuid())
  recordId        String
  conceptConfigId String
  key             String
  label           String
  gestoriaCode    String?
  value           Decimal  @default(0) @db.Decimal(12, 2)
  manualValue     Decimal? @db.Decimal(12, 2)
  isManual        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  record        PayrollControlRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  conceptConfig PayrollControlConceptConfig @relation(fields: [conceptConfigId], references: [id], onDelete: Restrict)

  @@unique([recordId, conceptConfigId])
  @@index([recordId])
  @@index([gestoriaCode])
}

model PayrollControlDailyEntry {
  id                   String    @id @default(uuid())
  recordId             String
  workDate             DateTime  @db.Date
  entryAt              DateTime?
  breakOutAt           DateTime?
  breakInAt            DateTime?
  exitAt               DateTime?
  workedHours          Decimal   @default(0) @db.Decimal(8, 2)
  discountHours        Decimal   @default(0) @db.Decimal(8, 2)
  scheduledHours       Decimal   @default(0) @db.Decimal(8, 2)
  overtimeHours        Decimal   @default(0) @db.Decimal(8, 2)
  holidayOvertimeHours Decimal   @default(0) @db.Decimal(8, 2)
  dietAmount           Decimal   @default(0) @db.Decimal(12, 2)
  isHoliday            Boolean   @default(false)
  isCalendarHoliday    Boolean   @default(false)
  holidayName          String?
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  record PayrollControlRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, workDate])
  @@index([recordId])
}

model PayrollControlExport {
  id           String   @id @default(uuid())
  periodId     String
  filename     String
  templateHash String
  outputHash   String
  content      Bytes
  mappingJson  String   @db.Text
  createdById  String
  createdAt    DateTime @default(now())

  period    PayrollControlPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([periodId, createdAt])
}
