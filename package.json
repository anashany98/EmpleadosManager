{
  "name": "nominas-app-monorepo",
  "version": "1.0.0",
  "description": "Aplicación para gestión de nóminas y exportación a Contasol",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "db:generate": "node scripts/prisma-local.mjs generate",
    "db:status": "node scripts/prisma-local.mjs migrate status",
    "db:migrate": "node scripts/prisma-local.mjs migrate dev",
    "pw:install": "playwright install chromium",
    "pw:smoke": "node scripts/playwright-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "concurrently": "^8.2.2",
    "playwright": "^1.59.0-alpha-1771104257000",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "prisma": {
    "seed": "npx ts-node database/prisma/seed.ts"
  }
}
