# HIGH-011: inline seed scripts that hardcode a literal password
# fallback are a credential-tampering vector. Always go through
# `backend/src/scripts/seed-admin.ts` with a real env var.
scripts/seed-admin-inline.js
scripts/*-inline.js
scripts/seed-admin*.js
