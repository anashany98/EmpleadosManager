# Ignore node_modules to prevent overwriting linux binaries with windows ones
**/node_modules
node_modules

# Ignore git metadata
.git
.gitignore

# Ignore build artifacts
dist
build
coverage
test-results
playwright-report
.playwright-mcp

# Ignore env files (secrets should be passed via environment variables)
.env
.env.*

# Ignore logs
*.log
npm-debug.log*
cookies.txt
*cookies.txt
login_response.json
*.png
# backend/assets/ contains static logos served via /assets/* at runtime
# (see backend/src/app/createApp.ts line 170). They are PNGs, so we need to
# re-include them after the global *.png ignore above.
!backend/assets/**
BUG_REPORT_*.md
TESTING_REPORT_*.md
nul

# Ignore IDE files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln

# Gemini
.gemini

# Heavy folders and data
uploads/
backup/
data/
*.sqlite
*.db
temp/
tmp/
